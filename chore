echo "To Home"
cd ~

echo "First Install"
sudo apt install software-properties-common apt-transport-https wget

echo "Creating Base Folders"
mkdir .config Knowlodge Repositories Playground .fonts
mkdir .config/kitty .config/zathura

echo "Setting Up Google"
wget -q https://dl-ssl.google.com/linux/linux_signing_key.pub -O- | sudo apt-key add -
sudo add-apt-repository "deb [arch=amd64] http://dl.google.com/linux/chrome/deb/ stable main"

echo "Setting Up VSCode"
wget -q https://packages.microsoft.com/keys/microsoft.asc -O- | sudo apt-key add -
sudo add-apt-repository "deb [arch=amd64] https://packages.microsoft.com/repos/vscode stable main"

echo "Update System"
sudo apt update

echo "Installing Favorite Softwares"
sudo apt install build-essential curl zsh fzf zoxide code zathura gh git google-chrome-stable kitty unzip zip emacs cargo fd-find

echo "Installing Starship"
curl -sS https://starship.rs/install.sh | sh

echo "Installing Rust Softwares"

cargo install exa ytop procs tokei 

echo "ZSH Plugins"
