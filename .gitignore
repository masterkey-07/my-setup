# Python bytecode from running the scripts in dotfiles/bin
__pycache__/
*.py[cod]

# Editor swap and backup files
*.swp
*.swo
*~
.netrwhist

# OS cruft
.DS_Store
.directory

# Local secrets and overrides that must never be committed
.env
*.local
# Password vaults and their key files (they live in ~/Vault, never in a repo)
*.kdbx
*.keyx

# Editor-local workspace settings (paths differ per machine)
.vscode/
