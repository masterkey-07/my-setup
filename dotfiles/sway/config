# Sway config.
# Validate after editing: sway -C -c ~/.config/sway/config
# Reference: man 5 sway

# Ubuntu's snippets: export WAYLAND_DISPLAY/XDG_CURRENT_DESKTOP to systemd and
# D-Bus, which portals, screen sharing and KeePassXC's Secret Service need.
include /etc/sway/config.d/*

set $mod Mod4

# Font for window titles. Will also be used by the bar unless a different font
# is used in the bar {} block below.
font pango:Caskaydia Cove Nerd Font 8

# Keyboard and cursor
input type:keyboard xkb_layout br
seat seat0 xcursor_theme Bibata-Modern-Ice 20

# Start XDG autostart .desktop files using dex. See also
# https://wiki.archlinux.org/index.php/XDG_Autostart
exec dex --autostart --environment sway

# Lock after 10 min idle, before suspend and on `loginctl lock-session` ($mod+l below);
# screens power off after 15 min idle
# gtklock (config and theme in ~/.config/gtklock) over the blurred wallpaper
set $lock gtklock --daemonize --layout ~/.config/gtklock/layout.ui --background ~/.cache/lock-wallpaper.jpg
exec swayidle -w \
        timeout 600 '$lock' \
        timeout 900 'swaymsg "output * power off"' resume 'swaymsg "output * power on"' \
        lock '$lock' \
        before-sleep '$lock'

# Password safe, started minimized to the tray: it is also the Secret Service
# keyring (gh, libsecret apps) and the SSH agent, so it must run from login
exec keepassxc
# Syncthing's tray icon; --wait holds it until waybar's tray is up
exec syncthingtray --wait

# Wallpaper on every output, including ones plugged in later
output * bg ~/.config/sway/wallpapers/tree.jpeg fill
# Blurred copy of it for the lock screen. On every reload too, so a new
# wallpaper reaches the lock screen without logging out; it is only redone
# when the wallpaper changes
exec_always lock-wallpaper

# External monitor above the laptop screen, laptop centered under it
output HDMI-A-1 position 0 0
output eDP-1 position 320 1080

# The NVIDIA driver sends no hotplug event when HDMI is unplugged, so sway
# keeps the dead output (and its workspaces). hdmi-watch probes the cable and
# turns the output off/on by itself; $mod+Ctrl+m (screens.conf) does it by hand
exec ~/.local/bin/hdmi-watch

# Move the mouse pointer to the center of a window when it gets focus
mouse_warping container

# Pomodoro timer, shown in waybar's pomodoro block (see uair-status)
exec ~/.local/bin/uair-status

# Hide the pointer after 5s idle and while typing
seat seat0 hide_cursor 5000
seat seat0 hide_cursor when-typing enable

# Volume keys (PipeWire); -l 1.0 caps raising at 100%, like waybar's
# sound block ("max-volume"), since above that the sound distorts
bindsym XF86AudioRaiseVolume exec wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+
bindsym XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym XF86AudioMicMute exec wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle

# Laptop screen brightness
bindsym XF86MonBrightnessUp exec brightnessctl set 5%+
bindsym XF86MonBrightnessDown exec brightnessctl set 5%-

# Use Mouse+$mod to drag floating windows to their wanted position
floating_modifier $mod normal

# move tiling windows via drag & drop by left-clicking into the title bar,
# or left-clicking anywhere into the window while holding the floating modifier.
tiling_drag enable

# start a terminal
bindsym $mod+Return exec ~/.local/bin/kitty-fast

# kill focused window
bindsym $mod+q kill

# start rofi (a program launcher; config in ~/.config/rofi/config.rasi)
bindsym $mod+d exec rofi -show drun

# search the Readest library and open a book
bindsym $mod+b exec ~/.local/bin/readest-books

# change focus
bindsym $mod+j focus left
bindsym $mod+k focus down
# up is on i, not l: $mod+l locks the screen (bound further down)
bindsym $mod+i focus up
bindsym $mod+ccedilla focus right

# alternatively, you can use the cursor keys:
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# move focused window
bindsym $mod+Shift+j move left
bindsym $mod+Shift+k move down
bindsym $mod+Shift+i move up
bindsym $mod+Shift+ccedilla move right

# alternatively, you can use the cursor keys:
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# split in horizontal orientation
bindsym $mod+h split h

# split in vertical orientation
bindsym $mod+v split v

# enter fullscreen mode for the focused container
bindsym $mod+f fullscreen toggle

# change container layout (stacked, tabbed, toggle split)
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split

# toggle tiling / floating
bindsym $mod+Shift+space floating toggle

# change focus between tiling / floating windows
bindsym $mod+space focus mode_toggle

# focus the parent container
bindsym $mod+a focus parent

# reload the configuration file (Sway has no in-place restart)
bindsym $mod+Shift+r reload
# exit sway (logs you out of your Wayland session)
bindsym $mod+Shift+e exec "swaynag -t warning -m 'You pressed the exit shortcut. Do you really want to exit sway? This will end your Wayland session.' -B 'Yes, exit sway' 'swaymsg exit'"

# resize window (you can also use the mouse for that)
mode "resize" {
        # These bindings trigger as soon as you enter the resize mode

        # Pressing left will shrink the window’s width.
        # Pressing right will grow the window’s width.
        # Pressing up will shrink the window’s height.
        # Pressing down will grow the window’s height.
        bindsym j resize shrink width 10 px or 10 ppt
        bindsym k resize grow height 10 px or 10 ppt
        bindsym i resize shrink height 10 px or 10 ppt
        bindsym ccedilla resize grow width 10 px or 10 ppt

        # same bindings, but for the arrow keys
        bindsym Left resize shrink width 10 px or 10 ppt
        bindsym Down resize grow height 10 px or 10 ppt
        bindsym Up resize shrink height 10 px or 10 ppt
        bindsym Right resize grow width 10 px or 10 ppt

        # back to normal: Enter or Escape or $mod+r
        bindsym Return mode "default"
        bindsym Escape mode "default"
        bindsym $mod+r mode "default"
}

bindsym $mod+r mode "resize"

# Waybar, config and theme in ~/.config/waybar; hide/show follows bar mode
bar {
        swaybar_command waybar
}
# A reload restarts waybar, whose new tray forgets KeePassXC's icon
exec_always ~/.local/bin/tray-reregister

# Orientation

default_orientation auto

# Applications Key Mapping

bindsym $mod+dead_acute exec google-chrome
bindsym $mod+bracketleft exec obsidian

# Single Chrome app windows: the key jumps to the site, launching it if needed
bindsym --release $mod+dead_tilde exec webapp web.whatsapp.com
bindsym --release $mod+bracketright exec webapp open.spotify.com

bindsym --release $mod+comma exec code
bindsym --release $mod+period exec discord
bindsym $mod+semicolon exec steam

bindsym --release $mod+slash exec summon com.anthropic.Claude claude-desktop
bindsym --release $mod+x exec summon KeePassXC keepassxc

bindsym --release $mod+p exec screenshot
bindsym --release $mod+l exec loginctl lock-session

# Configuration of Theme

include ~/.config/sway/theme.conf

# Configuration of Screens

include ~/.config/sway/screens.conf

# Configuration of Modes

include ~/.config/sway/pomodoro_mode.conf
