#!/usr/bin/env bash
# Run the uair pomodoro timer and keep its latest line in a file for the
# sway-status pomodoro block (started by the sway config). sway-status only
# rereads it every few seconds, so it is told to redraw after each line.
set -euo pipefail

status_file="$HOME/.cache/uair-status"
mkdir -p "${status_file%/*}"
# No file means no block in the bar once the timer stops
trap 'rm -f "$status_file" "$status_file.tmp"' EXIT

uair | while IFS= read -r line; do
  # Write then rename, so sway-status never reads a half-written file
  printf '%s\n' "$line" >"$status_file.tmp"
  mv "$status_file.tmp" "$status_file"
  # -f: started through env, so its process name is bash, not sway-status
  pkill -USR1 -f '^bash .*/sway-status$' || true
done
