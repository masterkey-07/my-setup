#!/usr/bin/env bash
# Run the uair pomodoro timer and keep its latest line in a file for
# waybar's custom/pomodoro block (started by the sway config). The block reads
# the file only when signalled, so it is told to redraw after each line.
set -euo pipefail

# WAYBAR_POMODORO_SIGNAL and POMODORO_STATUS_FILE
# shellcheck source=../waybar/blocks.sh
source "$HOME/.config/waybar/blocks.sh"
status_file="$POMODORO_STATUS_FILE"
# paused_state_text in uair.toml: a line starting with it means paused
readonly PAUSED_ICON=$'\U000F03E4'
# The block's clicks, set in the waybar config
readonly TOOLTIP="Click: start/pause · Right click: next session · Middle click: reset"
mkdir -p "${status_file%/*}"
# No file means no block in the bar once the timer stops
trap 'rm -f "$status_file" "$status_file.tmp"' EXIT

# The line as waybar JSON, with a "paused" class so the bar can dim it
waybar_json() {
  local line="$1" class="running"
  [[ "$line" == "$PAUSED_ICON"* ]] && class="paused"
  jq -n -c --arg text "$line" --arg class "$class" --arg tooltip "$TOOLTIP" \
    '{text: $text, class: $class, tooltip: $tooltip}'
}

uair | while IFS= read -r line; do
  # Write then rename, so waybar never reads a half-written file
  waybar_json "$line" >"$status_file.tmp"
  mv "$status_file.tmp" "$status_file"
  pkill -RTMIN+"$WAYBAR_POMODORO_SIGNAL" -x waybar || true
done
