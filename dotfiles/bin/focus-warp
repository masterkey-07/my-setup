#!/usr/bin/env python3
# Move the mouse pointer to the center of a window when it gets focus
# (started from the i3 config). i3's mouse_warping only handles outputs, so
# listen to i3 window events and warp with libX11. The pointer is left alone
# when it is already inside the window, so mouse focus never makes it jump.

import ctypes
import ctypes.util
import json
import subprocess
import time
from collections.abc import Iterator
from typing import TypedDict

I3_SUBSCRIBE_COMMAND = ["i3-msg", "-t", "subscribe", "-m", '["window"]']
RESUBSCRIBE_DELAY_SECONDS = 1


class Rect(TypedDict):
    x: int
    y: int
    width: int
    height: int


class Pointer:
    """The X pointer, read and moved through libX11."""

    def __init__(self) -> None:
        library = ctypes.util.find_library("X11")
        if not library:
            raise SystemExit("focus-warp: cannot find X11 library")
        self.x11 = load_x11(library)
        display: int | None = self.x11.XOpenDisplay(None)
        if not display:
            raise SystemExit("focus-warp: cannot open X display")
        self.display = display
        self.root: int = self.x11.XDefaultRootWindow(display)

    def position(self) -> tuple[int, int]:
        window, child = ctypes.c_ulong(), ctypes.c_ulong()
        x, y, window_x, window_y = (ctypes.c_int() for _ in range(4))
        mask = ctypes.c_uint()
        outputs = (window, child, x, y, window_x, window_y, mask)
        self.x11.XQueryPointer(
            self.display, self.root, *(ctypes.byref(v) for v in outputs)
        )
        return x.value, y.value

    def move_to(self, x: int, y: int) -> None:
        # No source window and a zero source rect: warp to absolute root coords.
        self.x11.XWarpPointer(self.display, 0, self.root, 0, 0, 0, 0, x, y)
        self.x11.XFlush(self.display)


def load_x11(library: str) -> ctypes.CDLL:
    x11 = ctypes.cdll.LoadLibrary(library)
    x11.XOpenDisplay.restype = ctypes.c_void_p
    x11.XDefaultRootWindow.argtypes = [ctypes.c_void_p]
    x11.XDefaultRootWindow.restype = ctypes.c_ulong
    x11.XQueryPointer.argtypes = [ctypes.c_void_p, ctypes.c_ulong] + [ctypes.c_void_p] * 7
    x11.XWarpPointer.argtypes = (
        [ctypes.c_void_p, ctypes.c_ulong, ctypes.c_ulong]
        + [ctypes.c_int] * 2
        + [ctypes.c_uint] * 2
        + [ctypes.c_int] * 2
    )
    x11.XFlush.argtypes = [ctypes.c_void_p]
    return x11


def contains(rect: Rect, x: int, y: int) -> bool:
    return (
        rect["x"] <= x < rect["x"] + rect["width"]
        and rect["y"] <= y < rect["y"] + rect["height"]
    )


def center(rect: Rect) -> tuple[int, int]:
    return rect["x"] + rect["width"] // 2, rect["y"] + rect["height"] // 2


def focused_window_rects() -> Iterator[Rect]:
    """Yield the rect of each newly focused window, forever."""
    # The subscription ends when i3 restarts ($mod+Shift+r), so subscribe again.
    while True:
        events = subprocess.Popen(I3_SUBSCRIBE_COMMAND, stdout=subprocess.PIPE, text=True)
        if events.stdout is None:
            raise SystemExit("focus-warp: cannot subscribe to i3 events")
        for line in events.stdout:
            event = json.loads(line)
            if event.get("change") == "focus":
                yield event["container"]["rect"]
        events.wait()
        time.sleep(RESUBSCRIBE_DELAY_SECONDS)


def main() -> None:
    pointer = Pointer()
    for rect in focused_window_rects():
        if not contains(rect, *pointer.position()):
            pointer.move_to(*center(rect))


if __name__ == "__main__":
    main()
